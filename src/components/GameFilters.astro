---
import type { Category, Publisher } from '../types/game';

/** Props for {@link GameFilters}: the full lists used to populate the filter controls. */
interface Props {
    /** All categories available to filter by, rendered as checkboxes. */
    categories: Category[];
    /** All publishers available to filter by, rendered as a select. */
    publishers: Publisher[];
}

const { categories, publishers } = Astro.props;
---

<div
    class="bg-slate-800/60 backdrop-blur-sm rounded-xl border border-slate-700/50 p-6 mb-6"
    data-testid="game-filters"
>
    <div class="flex flex-col sm:flex-row sm:items-start gap-6">
        <fieldset data-testid="category-filters">
            <legend class="text-sm font-medium text-slate-200 mb-2">Categories</legend>
            <div class="flex flex-wrap gap-x-4 gap-y-2">
                {categories.map((category) => (
                    <label class="flex items-center gap-2 text-sm text-slate-300 cursor-pointer">
                        <input
                            type="checkbox"
                            name="category"
                            value={category.id}
                            data-testid={`category-filter-${category.id}`}
                            class="rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                        />
                        {category.name}
                    </label>
                ))}
            </div>
        </fieldset>

        <div>
            <label for="publisher-filter" class="block text-sm font-medium text-slate-200 mb-2">
                Publisher
            </label>
            <select
                id="publisher-filter"
                data-testid="publisher-filter"
                class="bg-slate-900 border border-slate-600 text-slate-200 text-sm rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none p-2"
            >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                ))}
            </select>
        </div>

        <button
            type="button"
            data-testid="clear-filters"
            class="self-start sm:mt-6 text-sm font-medium text-blue-400 hover:text-blue-300 transition-colors focus:ring-2 focus:ring-blue-500 focus:outline-none rounded px-2 py-1"
        >
            Clear filters
        </button>
    </div>

    <p class="mt-4 text-sm text-slate-400" role="status" aria-live="polite" data-testid="filter-status"></p>
</div>
