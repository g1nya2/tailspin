---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import GameFilters from '../components/GameFilters.astro';
import { getDatabase } from '../lib/db';
import { getAllGames, getAllCategories, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
    getAllGames(db),
    getAllCategories(db),
    getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <Fragment>
          <GameFilters categories={categories} publishers={publishers} />

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <div class="hidden" data-testid="no-filter-results">
            <EmptyState text="No games match the selected filters." />
          </div>
        </Fragment>
      )}
    </div>
  </div>

  <script>
    // Client-side filtering: the site is fully static, so narrowing the
    // already-rendered game cards happens entirely in the browser based on
    // the data-category-id / data-publisher-id attributes embedded at build
    // time. No refetching or server round-trip is involved.
    const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
    const noResults = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');
    const status = document.querySelector<HTMLElement>('[data-testid="filter-status"]');
    const categoryCheckboxes = document.querySelectorAll<HTMLInputElement>(
      '[data-testid="category-filters"] input[type="checkbox"]',
    );
    const publisherSelect = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
    const clearButton = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');

    if (grid && status) {
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

      /** Shows/hides each game card based on the selected category and publisher filters. */
      function applyFilters(): void {
        const selectedCategories = new Set(
          Array.from(categoryCheckboxes)
            .filter((checkbox) => checkbox.checked)
            .map((checkbox) => checkbox.value),
        );
        const selectedPublisher = publisherSelect?.value ?? '';

        let visibleCount = 0;
        for (const card of cards) {
          const matchesCategory = selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
          const matchesPublisher = selectedPublisher === '' || card.dataset.publisherId === selectedPublisher;
          const isVisible = matchesCategory && matchesPublisher;
          card.classList.toggle('hidden', !isVisible);
          if (isVisible) visibleCount += 1;
        }

        grid!.classList.toggle('hidden', visibleCount === 0);
        noResults?.classList.toggle('hidden', visibleCount !== 0);
        status!.textContent =
          selectedCategories.size === 0 && selectedPublisher === ''
            ? `Showing all ${cards.length} games.`
            : `Showing ${visibleCount} of ${cards.length} games.`;
      }

      categoryCheckboxes.forEach((checkbox) => checkbox.addEventListener('change', applyFilters));
      publisherSelect?.addEventListener('change', applyFilters);
      clearButton?.addEventListener('click', () => {
        categoryCheckboxes.forEach((checkbox) => {
          checkbox.checked = false;
        });
        if (publisherSelect) publisherSelect.value = '';
        applyFilters();
      });

      applyFilters();
    }
  </script>
</Layout>

